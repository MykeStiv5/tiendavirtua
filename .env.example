# ---------- Variables PÚBLICAS (prefijo VITE_, llegan al navegador) ----------
# Supabase (Project Settings > API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# WhatsApp (sin + ni espacios)
VITE_WHATSAPP_NUMBER=573043409743

# Mercado Pago: Public Key de PRODUCCIÓN (APP_USR-...)
VITE_MERCADOPAGO_PUBLIC_KEY=

# ---------- Variables PRIVADAS (solo servidor, SIN prefijo VITE_) ----------
# Access Token de PRODUCCIÓN (APP_USR-...). Nunca lo expongas en el navegador.
MERCADOPAGO_ACCESS_TOKEN=
# URL pública de producción para back_urls (opcional; por defecto https://tiendavirtuafi.vercel.app)
SITE_URL=https://tiendavirtuafi.vercel.app
# Correo de respaldo para payer.email si el cliente no lo envía (opcional)
PAYER_FALLBACK_EMAIL=

# ---------- Variables PRIVADAS nuevas (solo servidor, SIN prefijo VITE_) ----------
# Supabase → Project Settings → API → clave "service_role". SECRETA: nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=
# (opcional) Si no la pones, se usa VITE_SUPABASE_URL
SUPABASE_URL=
# Mercado Pago → tu aplicación → Webhooks → clave secreta
MERCADOPAGO_WEBHOOK_SECRET=
# Correo saliente (Gmail: activa verificación en 2 pasos y crea una "contraseña de aplicación")
SMTP_USER=mykestiven5@gmail.com
SMTP_PASS=
# Quién recibe el aviso de cada venta (por defecto SMTP_USER)
OWNER_EMAIL=mykestiven5@gmail.com
# Opcionales: SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  MAIL_FROM="AREA 11 <tucorreo@gmail.com>"

# ---------- Variables PRIVADAS nuevas (migración 3) ----------
# Protege la tarea diaria de pedidos abandonados. Inventa una cadena larga y aleatoria.
# Vercel la envía sola al cron como "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
# (opcional) Horas sin pagar para que un pedido pase a "Abandonado" (por defecto 24)
ABANDON_AFTER_HOURS=24
# (opcional) true = además del resumen para ti, se envía recordatorio automático al cliente
ABANDONED_AUTO_REMINDER=false
